{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>renovate-bot/renovate-config"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres", "prodrigestivill/postgres-backup-local"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "Postgres major version upgrades require manual migration — do not update automatically"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.forgejo/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+OPENGREP_VERSION=(?<currentValue>v?\\S+)"
      ]
    }
  ]
}
