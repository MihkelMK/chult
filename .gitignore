.strapi-cloud.json

# Strapi Uploads
public/
public/uploads/*
!public/uploads/.gitkeep

# Strapi Output
dist
exports
types/generated/
src/extensions/documentation/

# Paraglide
src/lib/paraglide
project.inlang/cache/plugins
project.inlang/project_id

# Environment
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# SQLite
*.db
*.sql
*.sql.gz
# The *.sql rule above is for dumps and backups. Generated migrations and
# one-off ops scripts are source and must be tracked; drizzle/ was previously
# only in the repo via `git add -f`, which meant a newly generated migration
# would be silently ignored.
!drizzle/**/*.sql
!scripts/*.sql

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# User Data
uploads/*
!uploads/.gitkeep
backups

# Image cache
imgproxy-cache
