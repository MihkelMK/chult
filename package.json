{
  "name": "chult",
  "description": "Interactive hex crawler map with DM and Player views",
  "homepage": "https://github.com/MihkelMK/chult",
  "license": "GPL-3.0-only",
  "author": {
    "name": "Mihkel Martin Kasterpalu",
    "url": "https://kasterpalu.ee"
  },
  "repository": {
    "url": "https://github.com/MihkelMK/chult"
  },
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "LAUNCH_EDITOR=svelteDebugNvim.sh vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node scripts/migrate.js",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lucide/svelte": "1.14.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "24.12.2",
    "bits-ui": "2.19.0",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-svelte": "3.22.0",
    "eventemitter3": "5.0.4",
    "globals": "17.6.0",
    "konva": "10.3.2",
    "lint-staged": "17.0.4",
    "mode-watcher": "1.1.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.5.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "runed": "0.37.1",
    "shadcn-svelte": "1.5.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "svelte-konva": "1.0.1",
    "svelte-sonner": "1.1.1",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.0.16"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "lint-staged": {
    "*.{svelte,ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.{svelte,ts,js,toml})": [
      "prettier --write --ignore-unknown"
    ]
  }
}
