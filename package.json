{
  "name": "chult",
  "description": "Interactive hex crawler map with DM and Player views",
  "homepage": "https://github.com/MihkelMK/chult",
  "license": "GPL-3.0-only",
  "author": {
    "name": "Mihkel Martin Kasterpalu",
    "url": "https://kasterpalu.ee"
  },
  "repository": {
    "url": "https://github.com/MihkelMK/chult"
  },
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "LAUNCH_EDITOR=svelteDebugNvim.sh vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . --cache --cache-strategy content && eslint .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node scripts/migrate.js",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lucide/svelte": "1.72.0",
    "@sveltejs/adapter-node": "5.5.8",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "24.19.2",
    "bits-ui": "2.19.0",
    "cn": "0.5.2",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-svelte": "3.24.1",
    "eventemitter3": "5.0.4",
    "globals": "17.14.0",
    "konva": "10.3.0",
    "mode-watcher": "1.1.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "runed": "0.37.1",
    "shadcn-svelte": "1.8.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "svelte-konva": "1.0.1",
    "svelte-sonner": "1.1.1",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.1.6"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
